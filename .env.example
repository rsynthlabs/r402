# required: base MAINNET rpc (chain 8453) — verify.ts reads ExecutionLog there,
# and /api/anchor re-confirms the 1Shot-submitted tx receipt here.
# do NOT paste a sepolia rpc here — the paywall is on sepolia but the anchor read is mainnet.
BASE_RPC_URL=

# required for /api/anchor: relayer hot wallet private key. server signs
# ExecutionLog.record() txs from this wallet. fund with ~0.002 ETH on base
# mainnet (~60 anchors at current gas). NEVER commit.
# generate with `cast wallet new`.
RELAYER_PRIVATE_KEY=

# optional: per-request writeContract deadline (ms). default 30000.
RELAYER_TIMEOUT_MS=30000

# optional: local dev port. vercel ignores this.
PORT=3000
