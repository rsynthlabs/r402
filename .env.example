# required: base MAINNET rpc (chain 8453). verify.ts reads ExecutionLog logs
# here; /api/anchor signs writeContract here; both planes are mainnet.
# do NOT paste a sepolia rpc — there is no testnet plane anymore.
BASE_RPC_URL=

# required for /api/anchor: relayer hot wallet private key. server signs
# ExecutionLog.record() txs from this wallet. fund with ~0.002 ETH on base
# mainnet (~60 anchors at current gas). NEVER commit.
# generate with `cast wallet new`.
RELAYER_PRIVATE_KEY=

# optional: per-request writeContract deadline (ms). default 30000.
RELAYER_TIMEOUT_MS=30000

# optional: override the x402 facilitator URL. default is OpenX402
# (https://facilitator.openx402.ai) — permissionless, no KYC, no API keys.
# point at a self-hosted facilitator or a different permissionless host here.
FACILITATOR_URL=

# optional: local dev port. vercel ignores this.
PORT=3000
