# required: base MAINNET rpc (chain 8453) — verify.ts reads ExecutionLog there,
# and /api/anchor re-confirms the 1Shot-submitted tx receipt here.
# do NOT paste a sepolia rpc here — the paywall is on sepolia but the anchor read is mainnet.
BASE_RPC_URL=

# required for /api/anchor: 1Shot API key (free plan = 100 writes/mo).
# obtained from app.1shotapi.com. never inline in code — read at request time.
ONESHOT_API_KEY=

# required for /api/anchor: 1Shot method URL bound to ExecutionLog.record(bytes32,bytes)
# on chain 8453. obtained from the 1Shot dashboard after the manual prereqs in README.md.
# do NOT confuse with a Sepolia method — anchor writes go to Base MAINNET.
ONESHOT_METHOD_URL=

# optional: per-request 1Shot poll deadline (ms). default 30000.
ONESHOT_TIMEOUT_MS=30000

# optional: local dev port. vercel ignores this.
PORT=3000
